{
  "mcpServers": {
    "scrapling": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "--from", "scrapling[ai]", "scrapling", "mcp"],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "linkedin": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "mcp-server-linkedin@latest", "--transport", "stdio"],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
